# RPGMS Configuration Template (.env.example)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rpgms
TEST_DB_NAME=rpgms_test

# Runtime application credentials (restricted least-privilege)
DB_USER=rpgms_app
DB_PASSWORD=rpgms_app_pass

# Setup / Schema owner credentials (used only for db/setup_db.py)
DB_SETUP_USER=rpgms_owner
DB_SETUP_PASSWORD=rpgms_owner_pass

# Test execution credentials (used only on rpgms_test)
DB_TEST_USER=rpgms_test_user
DB_TEST_PASSWORD=rpgms_test_pass

# Flask application settings
SECRET_KEY=rpgms-development-secret-key-32chars-min-length-2026
APP_ENV=demo
FLASK_DEBUG=0
